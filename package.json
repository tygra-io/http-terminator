  "ava": {
    "extensions": [
      "ts"
    ],
    "files": [
      "test/http-terminator/**/*"
    ],
    "require": [
      "ts-node/register/transpile-only"
    ]
  },
  "dependencies": {
    "delay": "^5.0.0",
    "p-wait-for": "^3.2.0",
    "roarr": "^7.0.4",
    "type-fest": "^2.3.3"
  },
  "description": "Gracefully terminates HTTP(S) server.",
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^10.0.0",
    "agentkeepalive": "^4.1.4",
    "ava": "^3.15.0",
    "babel-plugin-istanbul": "^6.0.0",
    "babel-plugin-transform-export-default-name": "^2.1.0",
    "coveralls": "^3.1.1",
    "eslint": "^8.10.0",
    "eslint-config-canonical": "^33.0.1",
    "express": "^4.17.3",
    "fastify": "^3.27.2",
    "gitdown": "^3.1.4",
    "got": "^11.8.2",
    "husky": "^7.0.2",
    "nyc": "^15.1.0",
    "pem": "^1.14.4",
    "semantic-release": "^17.4.7",
    "sinon": "^11.1.2",
    "ts-node": "^10.2.1",
    "typescript": "^4.4.3"
  },
  "engines": {
    "node": ">=14"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint && pnpm run test && pnpm run build"
    }
  },
  "keywords": [
    "kubernetes",
    "prometheus"
  ],
  "license": "BSD-3-Clause",
  "main": "./dist/src/index.js",
  "name": "@tygra/http-terminator",
  "repository": {
    "type": "git",
    "url": "https://github.com/tygra-io/http-terminator"
  },
  "scripts": {
    "build": "rm -fr ./dist && tsc",
    "generate-readme": "gitdown ./.README/README.md --output-file ./README.md",
    "lint": "eslint ./src ./test && tsc --noEmit",
    "test": "NODE_ENV=test ava --serial --verbose"
  },
  "typings": "./dist/src/index.d.ts",
  "version": "1.0.0"
}
